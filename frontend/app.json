{
  "expo": {
    "name": "Depth Route Dialer",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.depthroute.dialer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#050B1A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.depthroute.dialer",
      "versionCode": 20260840
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/depthroute-mark-dark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#050B1A"
        }
      ],
      "expo-audio",
      "expo-asset",
      "./modules/expo-pjsip/app.plugin.js",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
